{
    "name": "craftzing/laravel-mollie-webhooks",
    "description": "Handle Mollie webhooks in a Laravel app",
    "keywords": [],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rémi Pelhate",
            "email": "remi.pelhate@craftzing.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "ext-json": "*",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "mollie/laravel-mollie": "^3.0",
        "spatie/laravel-webhook-client": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.54",
        "laravel/legacy-factories": "^1.1",
        "orchestra/testbench": "^7.8|^8.0",
        "phpstan/phpstan": "^1.8",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Craftzing\\Laravel\\MollieWebhooks\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Craftzing\\Laravel\\MollieWebhooks\\MollieWebhooksServiceProvider"
            ]
        }
    }
}
